# نبدأ من صورة (Image) جاهزة فيها بايثون 3.13 مثبت مسبقاً (نسخة "slim" أخف حجماً)
FROM python:3.13-slim

# نحدد مجلد العمل داخل الحاوية (كل الأوامر الجاية تشتغل من هذا المجلد)
WORKDIR /app

# ننسخ ملف المكتبات المطلوبة أولاً (قبل باقي الكود) - تفصيل تقني نشرحه تحت
COPY requirements.txt .

# نثبت كل المكتبات المذكورة بالملف
RUN pip install --no-cache-dir -r requirements.txt

# ننسخ باقي ملفات المشروع (الكود، النموذج المحفوظ) للحاوية
COPY . .

# نفتح المنفذ 5000 (نفس المنفذ اللي Flask يشتغل عليه)
EXPOSE 5000

# الأمر اللي يشتغل تلقائياً لما الحاوية تبدأ - يشغّل الـ API
CMD ["python", "src/app.py"]